# 数据库 (Neon 会在 Vercel 自动设置)
POSTGRES_URL_NON_POOLING="postgresql://..."

# 认证
JWT_SECRET="your-random-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_EMAIL="admin@example.com"

# 邮件发送 (Resend: https://resend.com 注册获取 API Key)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="My Blog <onboarding@resend.dev>"

# 站点地址 (生产环境填你的 Vercel 域名)
SITE_URL="https://colorblog.vercel.app"
