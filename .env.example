# 数据库（Vercel + Neon 会自动注入同名变量）
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/db?sslmode=require"

# 认证：必填，至少 32 个字符。缺失或过短会直接导致启动失败（这是有意为之）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# 管理员种子账号：执行 prisma db seed 时使用，密码至少 12 位。
# 请勿使用示例值，也请勿把真实值提交到版本库。
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# 站点信息（可选）
# SITE_URL 留空时会自动读取 Vercel 注入的域名，一般不需要配。
SITE_URL=""
# 站点名称会在浏览器端显示，必须用 NEXT_PUBLIC_ 前缀（Next 会把它内联进前端 bundle）。
# 不要用 SITE_NAME：服务端能读到，但客户端读不到，会导致前后端显示不一致。
NEXT_PUBLIC_SITE_NAME="My Blog"

# 是否开放注册（可选，默认 true）。
# 个人博客建议设为 false，改由管理员在后台建号，可一次性消除刷评论、XSS 载荷投放等滥用面。
ALLOW_REGISTRATION="true"
