# 数据库（Vercel + Neon 会自动注入同名变量）
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/db?sslmode=require"

# 会话签名密钥：必填，至少 32 个字符。缺失或过短会直接导致启动失败（这是有意为之）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# ---- OAuth 登录（必填）----
# 本站已改为使用 MemoVault（vault）统一账号登录，不再提供密码登录与自助注册。
# 下面四项缺任意一项，登录页会提示「尚未配置 OAuth 登录」。
#
# VAULT_ISSUER        vault 的对外地址，不要带结尾斜杠
# OAUTH_CLIENT_ID     与 vault 的 OAUTH_CLIENTS 里 clientId 保持一致
# OAUTH_CLIENT_SECRET 与 vault 的 OAUTH_CLIENTS 里 clientSecret 保持一致
# OAUTH_REDIRECT_URI  必须与 vault 里登记的 redirectUris 完全一致
VAULT_ISSUER="https://vault.colordev.space"
OAUTH_CLIENT_ID="color"
OAUTH_CLIENT_SECRET=""
OAUTH_REDIRECT_URI="https://blog.colordev.space/api/auth/oauth/callback"

# 管理员邮箱白名单（可选，逗号分隔）。
# 用这些邮箱通过 MemoVault 登录后会自动获得后台管理权限。
# 只授予、不回收：把人从这里删掉不会降级，需要在后台用户管理里手动改。
ADMIN_EMAILS=""

# 站点信息（可选）
# SITE_URL 留空时会自动读取 Vercel 注入的域名，一般不需要配。
SITE_URL=""
# 站点名称会在浏览器端显示，必须用 NEXT_PUBLIC_ 前缀（Next 会把它内联进前端 bundle）。
# 不要用 SITE_NAME：服务端能读到，但客户端读不到，会导致前后端显示不一致。
NEXT_PUBLIC_SITE_NAME="My Blog"
